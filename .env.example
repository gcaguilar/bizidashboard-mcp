# Shared Auth0 tenant used by DatosBizi.
AUTH0_DOMAIN=your-tenant.eu.auth0.com

# Exact API audience present in DatosBizi access tokens.
AUTH0_AUDIENCES=https://api.datosbizi.com

# Optional: restrict callers to known Auth0 clients (azp claim).
AUTH0_CLIENT_IDS=

# Public MCP URL. Required for production.
BASE_URL=https://mcp.datosbizi.com
PORT=80

# Never point this at an untrusted host when authenticated requests are enabled.
BIZI_ALLOWED_API_HOSTS=datosbizi.com
