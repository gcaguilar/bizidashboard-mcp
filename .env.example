# Shared Auth0 tenant used by DatosBizi.
AUTH0_DOMAIN=your-tenant.eu.auth0.com

# Exact API audience requested from Auth0 and accepted in access tokens.
AUTH0_AUDIENCE=https://api.datosbizi.com
# Optional plural allowlist for token verification; use the same value for one API.
AUTH0_AUDIENCES=https://api.datosbizi.com

# Optional: restrict callers to known Auth0 clients (azp claim).
AUTH0_ACCESS_TOKEN_ALLOWED_CLIENT_IDS=
# Backwards-compatible alias for AUTH0_ACCESS_TOKEN_ALLOWED_CLIENT_IDS.
AUTH0_CLIENT_IDS=

# Public MCP URL. Required for production.
BASE_URL=https://mcp.datosbizi.com
PORT=80

# Never point this at an untrusted host when authenticated requests are enabled.
BIZI_ALLOWED_API_HOSTS=datosbizi.com

# Local stdio compatibility only. The HTTP MCP/Actions server never sends this
# key: remote requests are authorized with the incoming user's bearer token.
BIZI_PUBLIC_API_KEY=
