# Production remote MCP: Auth0 receives a connector token for the MCP and
# exchanges it on behalf of the user for a DatosBizi API token.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
MCP_AUTH0_AUDIENCE=https://mcp.datosbizi.com/mcp
API_AUTH0_AUDIENCE=https://api.datosbizi.com
MCP_AUTH0_CLIENT_ID=<BiziDashboard MCP OBO Client ID>
MCP_AUTH0_CLIENT_SECRET=<BiziDashboard MCP OBO Client Secret>

# Public HTTP service.
BASE_URL=https://mcp.datosbizi.com
PORT=80
BIZI_ALLOWED_API_HOSTS=datosbizi.com

# Optional browser CORS allowlist. Claude and ChatGPT connectors do not need it.
# MCP_CORS_ORIGINS=https://datosbizi.com

# Local stdio login only; do not add these to the remote deployment unless you
# actually run `bizidashboard-mcp-login` there.
# AUTH0_CLIENT_ID=<local-cli-client-id>
# AUTH0_AUDIENCE=https://api.datosbizi.com
