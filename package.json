{
  "name": "bizidashboard-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing BiziDashboard's historical and analytical bike-share data (Zaragoza Bizi) as tools for LLM clients.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bizidashboard-mcp": "dist/index.js",
    "bizidashboard-mcp-http": "dist/http-index.js",
    "bizidashboard-mcp-login": "dist/login.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gcaguilar/bizidashboard-mcp.git"
  },
  "homepage": "https://github.com/gcaguilar/bizidashboard-mcp#readme",
  "bugs": {
    "url": "https://github.com/gcaguilar/bizidashboard-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bizi",
    "bike-share",
    "zaragoza"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http-index.js",
    "test": "npm run build && node --test --test-concurrency=1 --experimental-strip-types test/oauth.test.ts test/oauth-proxy.test.ts test/authorization.test.ts test/tools.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.1.0",
    "jose": "^6.2.8",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "typescript": "^7.0.2"
  }
}
